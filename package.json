{
  "name": "@deepseek-ai/dsh-web-auth",
  "description": "Username/password login gate for the DeepSeek Harness web GUI: adds a login route plane and bridges an authenticated user into the harness token-to-cookie handshake, for LAN/0.0.0.0 serving",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.1 || ^0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "1.8.5",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:/Users/later0day/Desktop/DSH/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-connection": "link:/Users/later0day/Desktop/DSH/deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-credentials": "link:/Users/later0day/Desktop/DSH/deepseek-harness/packages/credentials/credentials",
    "@deepseek-ai/dsh-host-webserver": "link:/Users/later0day/Desktop/DSH/deepseek-harness/packages/host/webserver",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
